<?xml version="1.0" encoding="UTF-8"?>
<!-- ### Canvas Settings ### -->
<interface>
  <template class="RnSettingsPanel" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout"></object>
    </property>
    <style>
      <class name="settings_panel" />
      <class name="background" />
    </style>
    <child>
      <object class="GtkScrolledWindow" id="settings_scroller">
        <property name="hscrollbar-policy">never</property>
        <property name="hexpand">true</property>
        <property name="vexpand">true</property>
        <property name="halign">fill</property>
        <property name="valign">fill</property>
        <property name="propagate-natural-width">false</property>
        <property name="propagate-natural-height">false</property>
        <property name="window-placement">top-left</property>
        <child>
          <object class="AdwClamp">
            <property name="margin-top">32</property>
            <property name="margin-bottom">24</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="maximum-size">800</property>
            <property name="tightening-threshold">600</property>
            <property name="hexpand">false</property>
            <property name="vexpand">true</property>
            <property name="valign">fill</property>
            <property name="halign">fill</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">32</property>
                <!-- General Group -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">General</property>
                    <child>
                      <object class="AdwSwitchRow" id="general_autosave_row">
                        <property name="title" translatable="yes">Autosave</property>
                        <property name="subtitle" translatable="yes">Enable or disable autosave</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="general_autosave_interval_secs_row">
                        <property name="title" translatable="yes">Autosave Interval (secs)</property>
                        <property name="subtitle" translatable="yes">Set the autosave interval in seconds</property>
                        <property name="adjustment">general_autosave_interval_secs_adj</property>
                        <property name="digits">0</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_show_scrollbars_row">
                        <property name="title" translatable="yes">Show Scrollbars</property>
                        <property name="subtitle" translatable="yes">Set whether the scrollbars on the canvas are shown</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_lock_toolbars_to_top_row">
                        <property name="title" translatable="yes">Lock Toolbars to Top</property>
                        <property name="subtitle" translatable="yes">Keep the toolbars at the top edge of the window. When disabled, drag a toolbar by its handle to place it where you want.</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_dock_toolbars_on_drop_row">
                        <property name="title" translatable="yes">Dock Toolbars When Dropped at Edges</property>
                        <property name="subtitle" translatable="yes">When enabled, releasing a toolbar near a window edge docks it; hold Shift to keep it floating. When disabled, hold Shift to dock it.</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_optimize_epd_row">
                        <property name="title" translatable="yes">Optimize for E-Paper Displays</property>
                        <property name="subtitle" translatable="yes">Changes certain UI elements and modifies behaviour
of tools for optimized usage on E-Paper displays</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_inertial_scrolling_row">
                        <property name="title" translatable="yes">Inertial Touch Scrolling</property>
                        <property name="subtitle" translatable="yes">Set whether touch scrolling on the canvas is inertial.
An application restart is required when this option
gets disabled.</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="general_regular_cursor_picker_row">
                        <property name="title" translatable="yes">Regular Cursor</property>
                        <property name="subtitle" translatable="yes">Set the regular cursor</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <child>
                              <object class="GtkMenuButton" id="general_regular_cursor_picker_menubutton">
                                <property name="hexpand">false</property>
                                <property name="hexpand">false</property>
                                <property name="valign">center</property>
                                <property name="halign">end</property>
                                <property name="popover">general_regular_cursor_picker_popover</property>
                                    <property name="icon-name">cursor-dot-medium</property>
                                <style>
                                  <class name="cursor_picker_button" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_show_drawing_cursor_row">
                        <property name="title" translatable="yes">Show Drawing Cursor</property>
                        <property name="subtitle" translatable="yes">Set whether the drawing cursor is visible</property>
                        <property name="active">true</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_hide_pen_cursor_row">
                        <property name="title" translatable="yes">Hide Cursor for the Pen</property>
                        <property name="subtitle" translatable="yes">Show no cursor while a pen hovers over or draws on the canvas. The mouse and touchpad keep theirs</property>
                        <property name="active">false</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="general_hide_eraser_square_row">
                        <property name="title" translatable="yes">Hide Eraser Square for the Pen</property>
                        <property name="subtitle" translatable="yes">Show no square while a pen hovers or erases with the eraser. The mouse and touchpad keep it</property>
                        <property name="active">false</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="general_drawing_cursor_picker_row">
                        <property name="title" translatable="yes">Drawing Cursor</property>
                        <property name="subtitle" translatable="yes">Set the drawing cursor</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <child>
                              <object class="GtkMenuButton" id="general_drawing_cursor_picker_menubutton">
                                <property name="hexpand">false</property>
                                <property name="hexpand">false</property>
                                <property name="valign">center</property>
                                <property name="halign">end</property>
                                <property name="popover">general_drawing_cursor_picker_popover</property>
                                <property name="icon-name">cursor-dot-small</property>
                                <style>
                                  <class name="cursor_picker_button" />
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Zen Group -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Zen Mode</property>
                    <child>
                      <object class="AdwActionRow" id="zen_accel_all_monitors_row">
                        <property name="title" translatable="yes">Zen Across All Monitors</property>
                        <property name="subtitle" translatable="yes">Covers every monitor with one window. Needs a compositor that can place a window across monitors (Hyprland); others fall back to the active monitor. Click the shortcut to change it.</property>
                        <child type="suffix">
                          <object class="GtkMenuButton" id="zen_accel_all_monitors_button">
                            <property name="valign">center</property>
                            <property name="popover">zen_accel_all_monitors_popover</property>
                            <child>
                              <object class="GtkLabel" id="zen_accel_all_monitors_label"/>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="zen_accel_active_monitor_row">
                        <property name="title" translatable="yes">Zen on the Active Monitor</property>
                        <property name="subtitle" translatable="yes">Fullscreens the window on the monitor it is on. Click the shortcut to change it.</property>
                        <child type="suffix">
                          <object class="GtkMenuButton" id="zen_accel_active_monitor_button">
                            <property name="valign">center</property>
                            <property name="popover">zen_accel_active_monitor_popover</property>
                            <child>
                              <object class="GtkLabel" id="zen_accel_active_monitor_label"/>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Format Group -->
                <child>
                  <object class="AdwPreferencesGroup" id="format_preferences_group">
                    <property name="title" translatable="yes">Page Format</property>
                    <child type="header-suffix">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="format_save_preset_button">
                            <property name="icon_name">save-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Save as Preset</property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="format_restore_preset_button">
                            <property name="icon_name">restore-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Restore From Preset</property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="format_predefined_formats_row">
                        <property name="title" translatable="yes">Format</property>
                        <property name="subtitle" translatable="yes">Choose a format</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">A6</item>
                              <item translatable="yes">A5</item>
                              <item translatable="yes">A4</item>
                              <item translatable="yes">A3</item>
                              <item translatable="yes">A2</item>
                              <item translatable="yes">US letter</item>
                              <item translatable="yes">US legal</item>
                              <item translatable="yes">Custom</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="format_orientation_row">
                        <property name="title" translatable="yes">Orientation</property>
                        <property name="subtitle" translatable="yes">Set the format orientation</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="homogeneous">true</property>
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <style>
                              <class name="linked" />
                            </style>
                            <child>
                              <object class="GtkToggleButton" id="format_orientation_portrait_toggle">
                                <property name="label" translatable="yes">Portrait</property>
                                <property name="active">true</property>
                              </object>
                            </child>
                            <child>
                              <object class="GtkToggleButton" id="format_orientation_landscape_toggle">
                                <property name="label" translatable="yes">Landscape</property>
                                <property name="group">format_orientation_portrait_toggle</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="format_width_row">
                        <property name="title" translatable="yes">Width</property>
                        <property name="subtitle" translatable="yes">Set the format width</property>
                        <style>
                          <class name="spin" />
                        </style>
                        <child type="suffix">
                          <object class="RnUnitEntry" id="format_width_unitentry">
                            <property name="vexpand">false</property>
                            <property name="hexpand">false</property>
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="format_height_row">
                        <property name="title" translatable="yes">Height</property>
                        <property name="subtitle" translatable="yes">Set the format height</property>
                        <style>
                          <class name="spin" />
                        </style>
                        <child type="suffix">
                          <object class="RnUnitEntry" id="format_height_unitentry">
                            <property name="vexpand">false</property>
                            <property name="hexpand">false</property>
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="format_dpi_row">
                        <property name="title" translatable="yes">Dpi</property>
                        <property name="subtitle" translatable="yes">Set the Dpi (dots per inch). Defaults to 96.</property>
                        <property name="adjustment">format_dpi_adj</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="format_apply_row">
                        <child type="prefix">
                          <object class="GtkButton" id="format_revert_button">
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <property name="label" translatable="yes">Revert</property>
                          </object>
                        </child>
                        <child type="suffix">
                          <object class="GtkButton" id="format_apply_button">
                            <property name="hexpand">true</property>
                            <property name="halign">end</property>
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <property name="label" translatable="yes">Apply</property>
                            <style>
                              <class name="suggested-action" />
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Document Group -->
                <child>
                  <object class="AdwPreferencesGroup" id="doc_preferences_group">
                    <property name="title" translatable="yes">Document</property>
                    <child type="header-suffix">
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <child>
                          <object class="GtkButton" id="doc_save_preset_button">
                            <property name="icon_name">save-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Save as Preset</property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="doc_restore_preset_button">
                            <property name="icon_name">restore-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Restore From Preset</property>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="doc_document_layout_row">
                        <property name="title" translatable="yes">Document Layout</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">Fixed Size</item>
                              <item translatable="yes">Continuous Vertical</item>
                              <item translatable="yes">Semi Infinite</item>
                              <item translatable="yes">Infinite</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="doc_show_format_borders_row">
                        <property name="title" translatable="yes">Show Format Borders</property>
                        <property name="subtitle" translatable="yes">Set whether the format borders are shown</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="doc_format_border_color_row">
                        <property name="title" translatable="yes">Format Border Color</property>
                        <property name="subtitle" translatable="yes">Set the format border color</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="hexpand">false</property>
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkColorDialog" id="doc_format_border_color_dialog"></object>
                              <object class="GtkColorDialogButton" id="doc_format_border_color_button">
                                <property name="dialog">doc_format_border_color_dialog</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="doc_background_color_row">
                        <property name="title" translatable="yes">Color</property>
                        <property name="subtitle" translatable="yes">Set the background color</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="hexpand">false</property>
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkColorDialog" id="doc_background_color_dialog"></object>
                              <object class="GtkColorDialogButton" id="doc_background_color_button">
                                <property name="dialog">doc_background_color_dialog</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="doc_background_patterns_row">
                        <property name="title" translatable="yes">Pattern</property>
                        <property name="subtitle" translatable="yes">Choose a background pattern</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">None</item>
                              <item translatable="yes">Lines</item>
                              <item translatable="yes">Grid</item>
                              <item translatable="yes">Dots</item>
                              <item translatable="yes">Isometric Grid</item>
                              <item translatable="yes">Isometric Dots</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="doc_background_pattern_color_row">
                        <property name="title" translatable="yes">Pattern Color</property>
                        <property name="subtitle" translatable="yes">Set the background pattern color</property>
                        <child type="suffix">
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">6</property>
                            <property name="hexpand">false</property>
                            <property name="vexpand">false</property>
                            <property name="valign">center</property>
                            <child>
                              <object class="GtkColorDialog" id="doc_background_pattern_color_dialog"></object>
                              <object class="GtkColorDialogButton" id="doc_background_pattern_color_button">
                                <property name="dialog">doc_background_pattern_color_dialog</property>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="doc_background_pattern_width_row">
                        <property name="title" translatable="yes">Pattern Width</property>
                        <property name="subtitle" translatable="yes">Set the background pattern width</property>
                        <style>
                          <class name="spin" />
                        </style>
                        <child type="suffix">
                          <object class="RnUnitEntry" id="doc_background_pattern_width_unitentry">
                            <property name="vexpand">false</property>
                            <property name="hexpand">false</property>
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="doc_background_pattern_height_row">
                        <property name="title" translatable="yes">Pattern Height</property>
                        <property name="subtitle" translatable="yes">Set the background pattern height</property>
                        <style>
                          <class name="spin" />
                        </style>
                        <child type="suffix">
                          <object class="RnUnitEntry" id="doc_background_pattern_height_unitentry">
                            <property name="vexpand">false</property>
                            <property name="hexpand">false</property>
                            <property name="halign">end</property>
                            <property name="valign">center</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="doc_show_origin_indicator_row">
                        <property name="title" translatable="yes">Show Origin Indicator</property>
                        <property name="subtitle" translatable="yes">Set whether the document origin indicator is shown</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="background_pattern_invert_color_row">
                        <property name="title" translatable="yes">Invert Color Brightness</property>
                        <property name="subtitle" translatable="yes">Invert the brightness of the background and pattern colors</property>
                        <child type="suffix">
                          <object class="GtkButton" id="background_pattern_invert_color_button">
                            <property name="valign">center</property>
                            <property name="label" translatable="yes">Invert</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Gestures Group -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Gestures</property>
                    <child>
                      <object class="AdwExpanderRow" id="gestures_scribbleerase_row">
                        <property name="title" translatable="yes">Scribble to Erase</property>
                        <property name="subtitle" translatable="yes">Scribble over pen ink to erase it. Typed text and highlighter ink are not erased</property>
                        <property name="show-enable-switch">true</property>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_min_turns_row">
                            <property name="title" translatable="yes">Minimum Turns</property>
                            <property name="tooltip-text" translatable="yes">How often the stroke has to turn back on itself. Raise it if handwriting gets erased</property>
                            <property name="numeric">true</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">20</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">2</property>
                                <property name="value">3</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_min_speed_row">
                            <property name="title" translatable="yes">Minimum Speed (px/s)</property>
                            <property name="tooltip-text" translatable="yes">How fast the pen has to move on screen. Raise it if slowly going back and forth to mark or shade gets erased, lower it if a slow scratch-out stays as ink. 0 to ignore the speed</property>
                            <property name="numeric">true</property>
                            <property name="digits">0</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">0</property>
                                <property name="upper">5000</property>
                                <property name="step-increment">50</property>
                                <property name="page-increment">250</property>
                                <property name="value">400</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_pass_height_row">
                            <property name="title" translatable="yes">Turn Height (%)</property>
                            <property name="tooltip-text" translatable="yes">How far the stroke has to run back for a turn to count, relative to the width of the band it scratches across. Raise it if handwriting gets erased</property>
                            <property name="numeric">true</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">5</property>
                                <property name="upper">100</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">10</property>
                                <property name="value">20</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_pass_length_row">
                            <property name="title" translatable="yes">Turn Length (px)</property>
                            <property name="tooltip-text" translatable="yes">The shortest run back on screen that counts as a turn, so a shaky hand does not</property>
                            <property name="numeric">true</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">100</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">5</property>
                                <property name="value">8</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_min_size_row">
                            <property name="title" translatable="yes">Minimum Size (px)</property>
                            <property name="tooltip-text" translatable="yes">How large on screen the scribble has to be. Smaller ones stay strokes</property>
                            <property name="numeric">true</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">5</property>
                                <property name="upper">500</property>
                                <property name="step-increment">5</property>
                                <property name="page-increment">25</property>
                                <property name="value">30</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwSpinRow" id="gestures_scribbleerase_min_length_row">
                            <property name="title" translatable="yes">Length Ratio</property>
                            <property name="tooltip-text" translatable="yes">How many times longer than its diagonal the stroke has to be</property>
                            <property name="numeric">true</property>
                            <property name="digits">1</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">20</property>
                                <property name="step-increment">0.1</property>
                                <property name="page-increment">1</property>
                                <property name="value">2</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="AdwButtonRow" id="gestures_scribbleerase_reset_row">
                            <property name="title" translatable="yes">Reset to Defaults</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="gestures_shaperecognition_row">
                        <property name="title" translatable="yes">Draw and Hold</property>
                        <property name="subtitle" translatable="yes">Hold the pen still at the end of a drawn stroke to replace it with the recognized geometric shape</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="gestures_shaperecognition_delay_row">
                        <property name="title" translatable="yes">Hold Duration</property>
                        <property name="subtitle" translatable="yes">The duration in seconds the pen has to be held still to recognize the shape</property>
                        <property name="numeric">true</property>
                        <property name="digits">2</property>
                        <property name="width-chars">6</property>
                        <property name="climb-rate">0.01</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">0.1</property>
                            <property name="upper">2</property>
                            <property name="step-increment">0.05</property>
                            <property name="page-increment">0.25</property>
                            <property name="value">0.2</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="gestures_bracket_style_row">
                        <property name="title" translatable="yes">Round Bracket Shape</property>
                        <property name="tooltip-text" translatable="yes">An arc bulges as deeply as it was drawn, a rounded parenthesis keeps a straight body with rounded corners, a square bracket has a straight body with a right angle at each end. A stroke drawn with a sharp corner at each end is a square bracket whatever is chosen here</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">Arc</item>
                              <item translatable="yes">Rounded corners</item>
                              <item translatable="yes">Square corners</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwComboRow" id="gestures_brace_style_row">
                        <property name="title" translatable="yes">Curly Brace Shape</property>
                        <property name="tooltip-text" translatable="yes">As the brace is set in type, with the cusp turned over a fillet so it has no sharp point, or with a right angle at each tip and a right-angled tab at the cusp</property>
                        <property name="model">
                          <object class="GtkStringList">
                            <items>
                              <item translatable="yes">Curly</item>
                              <item translatable="yes">Rounded cusp</item>
                              <item translatable="yes">Square corners</item>
                            </items>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSpinRow" id="gestures_bracket_corner_radius_row">
                        <property name="title" translatable="yes">Bracket Corner Radius (%)</property>
                        <property name="tooltip-text" translatable="yes">How much of its height a rounded parenthesis spends on its corners. A larger radius makes the parenthesis rounder, a smaller one makes it straighter</property>
                        <property name="numeric">true</property>
                        <property name="digits">0</property>
                        <property name="adjustment">
                          <object class="GtkAdjustment">
                            <property name="lower">2</property>
                            <property name="upper">40</property>
                            <property name="step-increment">1</property>
                            <property name="page-increment">5</property>
                            <property name="value">12</property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="gestures_curve_recognition_row">
                        <property name="title" translatable="yes">Smooth Curves</property>
                        <property name="subtitle" translatable="yes">Hold the pen still at the end of a drawn stroke to replace it with a smooth curve</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="gestures_circle_lasso_row">
                        <property name="title" translatable="yes">Circle to Lasso</property>
                        <property name="subtitle" translatable="yes">Draw a closed loop around ink to select it and switch to the selector</property>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="gestures_multi_touch_undo_redo_row">
                        <property name="title" translatable="yes">Two- and Three-Finger Double Tap</property>
                        <property name="subtitle" translatable="yes">Double tap with two fingers to undo, with three fingers to redo</property>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Button Shortcuts Group -->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Button Shortcuts</property>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_stylus_button_primary_row">
                        <property name="title" translatable="yes">Stylus Primary Button Action</property>
                        <property name="subtitle" translatable="yes">Set the action for the
primary stylus button</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">stylus-button-primary-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_stylus_button_secondary_row">
                        <property name="title" translatable="yes">Stylus Secondary Button Action</property>
                        <property name="subtitle" translatable="yes">Set the action for the
secondary stylus button</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">stylus-button-secondary-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_mouse_button_secondary_row">
                        <property name="title" translatable="yes">Mouse Secondary Button Action</property>
                        <property name="subtitle" translatable="yes">Set the action for the
secondary mouse button</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">mouse-button-secondary-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_touch_two_finger_long_press_row">
                        <property name="title" translatable="yes">Touch Two-Finger Long-Press Action</property>
                        <property name="subtitle" translatable="yes">Set the action for the touch
two-finger long-press gesture</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">touch-two-finger-long-press-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_keyboard_ctrl_space_row">
                        <property name="title" translatable="yes">Keyboard Ctrl-Space Action</property>
                        <property name="subtitle" translatable="yes">Set the action for the keyboard
Ctrl plus Space shortcut</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">keyboard-ctrl-space-shortcut-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_drawing_pad_button_0">
                        <property name="title" translatable="yes">Drawing Pad Button 1 Action</property>
                        <property name="subtitle" translatable="yes">Set the action for button 1
on a drawing pad</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">drawing-pad-button-1-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_drawing_pad_button_1">
                        <property name="title" translatable="yes">Drawing Pad Button 2 Action</property>
                        <property name="subtitle" translatable="yes">Set the action for button 2
on a drawing pad</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">drawing-pad-button-2-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_drawing_pad_button_2">
                        <property name="title" translatable="yes">Drawing Pad Button 3 Action</property>
                        <property name="subtitle" translatable="yes">Set the action for button 3
on a drawing pad</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">drawing-pad-button-3-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenShortcutRow" id="penshortcut_drawing_pad_button_3">
                        <property name="title" translatable="yes">Drawing Pad Button 4 Action</property>
                        <property name="subtitle" translatable="yes">Set the action for button 4
on a drawing pad</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">drawing-pad-button-4-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <!-- Lock settings for the pen/eraser-->
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Stylus pen modes</property>
                    <child>
                      <object class="RnPenModeRow" id="lock_pen_mode">
                        <property name="title" translatable="yes">Tool for the pen action</property>
                        <property name="subtitle" translatable="yes">Set/lock the action for the pen</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">stylus-pen-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="RnPenModeRow" id="lock_eraser_mode">
                        <property name="title" translatable="yes">Tool for the eraser action</property>
                        <property name="subtitle" translatable="yes">Set/lock the action for the eraser</property>
                        <child type="prefix">
                          <object class="GtkImage">
                            <property name="icon_name">stylus-button-eraser-symbolic</property>
                            <property name="icon-size">large</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </child>
    <object class="GtkPopover" id="general_regular_cursor_picker_popover">
      <child>
        <object class="RnIconPicker" id="general_regular_cursor_picker">
          <property name="valign">center</property>
        </object>
      </child>
    </object>
    <object class="GtkPopover" id="general_drawing_cursor_picker_popover">
      <child>
        <object class="RnIconPicker" id="general_drawing_cursor_picker">
          <property name="valign">center</property>
        </object>
      </child>
    </object>
    <object class="GtkPopover" id="zen_accel_active_monitor_popover">
      <child>
        <object class="GtkBox" id="zen_accel_active_monitor_capture">
          <property name="can-focus">true</property>
          <property name="margin-start">18</property>
          <property name="margin-end">18</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
          <child>
            <object class="GtkLabel" id="zen_accel_active_monitor_prompt">
              <property name="label" translatable="yes">Press the new key combination</property>
            </object>
          </child>
        </object>
      </child>
    </object>
    <object class="GtkPopover" id="zen_accel_all_monitors_popover">
      <child>
        <object class="GtkBox" id="zen_accel_all_monitors_capture">
          <property name="can-focus">true</property>
          <property name="margin-start">18</property>
          <property name="margin-end">18</property>
          <property name="margin-top">12</property>
          <property name="margin-bottom">12</property>
          <child>
            <object class="GtkLabel" id="zen_accel_all_monitors_prompt">
              <property name="label" translatable="yes">Press the new key combination</property>
            </object>
          </child>
        </object>
      </child>
    </object>
    <object class="GtkAdjustment" id="format_dpi_adj">
      <property name="step-increment">1</property>
      <property name="upper">5000</property>
      <property name="lower">1</property>
      <property name="value">96</property>
    </object>
    <object class="GtkAdjustment" id="general_autosave_interval_secs_adj">
      <property name="step-increment">1</property>
      <property name="upper">9999</property>
      <property name="lower">5</property>
      <property name="value">120</property>
    </object>
  </template>
</interface>
